# Application Environment
ENVIRONMENT=development
DEBUG=true
PORT=8000
SECRET_KEY=change-this-in-production-random-secret-key
DEMO_MODE=false

# PostgreSQL with pgvector
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=scamgraph
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/scamgraph

# Neo4j Graph Database
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=scamgraph_password

# AI & Embedding Models
EMBEDDING_MODEL_NAME=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
DEVICE=cpu

# External Investigation Services
TINYFISH_MODE=mock
TINYFISH_API_KEY=your-tinyfish-api-key-here
TINYFISH_BASE_URL=https://api.tinyfish.io/v1

# Frontend (apps/web)
BACKEND_URL=http://localhost:8001
NEXT_PUBLIC_API_URL=http://localhost:8001/api/v1
NEXT_PUBLIC_BACKEND_URL=http://localhost:8001
