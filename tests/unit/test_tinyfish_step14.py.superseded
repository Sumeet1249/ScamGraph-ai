"""Unit tests for Step 14: TinyFish WebInvestigator (Mocked)."""

import unittest
from unittest.mock import AsyncMock, patch

from services.investigation.tinyfish.parser import TinyFishObservationParser
from services.investigation.tinyfish.service import WebInvestigatorService
from services.investigation.tinyfish.client import TinyFishClient
from packages.schemas import SignalDimension, SignalSeverity


class TestTinyFishStep14(unittest.TestCase):
    def test_parser_extracts_canonical_evidence(self):
        mock_payload = {
            "claimed_brand": "State Bank of India",
            "page_title": "SBI NetBanking Verification",
            "login_fields": ["username", "password"],
            "credential_fields": ["netbanking_password", "pan_number"],
            "otp_fields": ["sms_otp", "profile_password"],
            "payment_fields": ["amount_inr"],
            "phone_numbers": ["+919876543210"],
            "email_addresses": [],
            "linked_domains": ["sbi-kyc-verify.online"],
            "redirects": [],
            "urgency_claims": ["Account will be deactivated in 24 hours"],
            "financial_claims": ["Penalty of Rs 5000"],
            "observable_impersonation_signals": ["State Bank logo displayed"],
            "evidence": ["Forms observed in DOM"],
        }

        signals = TinyFishObservationParser.parse(
            incident_id="inc_tf_01",
            inspected_url="http://sbi-kyc-verify.online/login",
            raw_data=mock_payload,
        )

        self.assertGreaterEqual(len(signals), 4)
        types = [s.signal_type for s in signals]
        self.assertIn("OTP_INPUT_FORM_OBSERVED", types)
        self.assertIn("CREDENTIAL_HARVEST_FORM_OBSERVED", types)
        self.assertIn("PAGE_LEVEL_PAYMENT_PROMPT", types)
        self.assertIn("UNVERIFIED_BRAND_IMPERSONATION_CLAIM", types)
        self.assertIn("PAGE_LEVEL_URGENCY_OBSERVED", types)

        # Check OTP signal severity
        otp_sig = next(s for s in signals if s.signal_type == "OTP_INPUT_FORM_OBSERVED")
        self.assertEqual(otp_sig.severity, SignalSeverity.CRITICAL)

    def test_parser_handles_malformed_and_partial_payloads(self):
        # Empty dict
        signals_empty = TinyFishObservationParser.parse("inc_tf_02", "http://example.com", {})
        self.assertEqual(signals_empty, [])

        # Non-dict
        signals_none = TinyFishObservationParser.parse("inc_tf_02", "http://example.com", None)  # type: ignore
        self.assertEqual(signals_none, [])

    async def _run_service_ssrf_test(self):
        service = WebInvestigatorService()
        signals = await service.investigate("inc_tf_03", "http://127.0.0.1:8000/secret")
        self.assertEqual(len(signals), 1)
        self.assertEqual(signals[0].signal_type, "SSRF_UNSAFE_DESTINATION_BLOCKED")

    def test_service_blocks_ssrf_before_network_call(self):
        import asyncio
        asyncio.run(self._run_service_ssrf_test())


if __name__ == "__main__":
    unittest.main()
